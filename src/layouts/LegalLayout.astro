---
import Layout from "./Layout.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  activeTab: "aviso-legal" | "privacidad" | "cookies";
}

const { title, description, activeTab } = Astro.props;
---

<Layout title={`${title} · RAÍCES`} description={description}>
  <!-- Cabecera simplificada para páginas legales -->
  <header class="border-b border-border/80 bg-sand/40 backdrop-blur-sm sticky top-0 z-30">
    <div class="shell flex items-center justify-between px-6 py-4 md:px-12">
      <a href="/" class="group flex items-center gap-3 leading-none" aria-label="Volver a RAÍCES">
        <img
          src="/logo.webp"
          alt="RAÍCES"
          width={40}
          height={33}
          class="h-9 w-11 rounded object-contain"
        />
        <div>
          <span class="font-display text-xl tracking-tight text-foreground">RAÍCES</span>
          <span class="block text-[0.5625rem] uppercase tracking-[0.22em] text-muted-foreground">
            Intervención socioeducativa
          </span>
        </div>
      </a>

      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-background/80 px-4 py-2 text-xs font-medium text-foreground transition-all duration-200 hover:border-primary/60 hover:text-primary shadow-xs"
      >
        <span>← Volver al inicio</span>
      </a>
    </div>
  </header>

  <!-- Pestañas de navegación legal -->
  <nav class="bg-sand/20 border-b border-border/60 py-3" aria-label="Navegación legal">
    <div class="shell px-6 md:px-12 flex flex-wrap items-center gap-2 sm:gap-4 text-xs font-medium">
      <span class="text-muted-foreground uppercase text-[10px] tracking-wider mr-2 font-mono">
        Documentos legales:
      </span>
      <a
        href="/aviso-legal"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          activeTab === "aviso-legal"
            ? "bg-primary text-primary-foreground font-semibold"
            : "text-muted-foreground hover:text-foreground hover:bg-sand/60"
        }`}
      >
        Aviso Legal
      </a>
      <a
        href="/privacidad"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          activeTab === "privacidad"
            ? "bg-primary text-primary-foreground font-semibold"
            : "text-muted-foreground hover:text-foreground hover:bg-sand/60"
        }`}
      >
        Política de Privacidad
      </a>
      <a
        href="/cookies"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          activeTab === "cookies"
            ? "bg-primary text-primary-foreground font-semibold"
            : "text-muted-foreground hover:text-foreground hover:bg-sand/60"
        }`}
      >
        Política de Cookies
      </a>
    </div>
  </nav>

  <!-- Contenido principal -->
  <main class="shell px-6 py-12 md:px-12 md:py-16 max-w-4xl">
    <article class="prose prose-stone max-w-none">
      <slot />
    </article>
  </main>

  <!-- Footer legal simplificado -->
  <footer class="border-t border-border/80 bg-sand/30 py-8 px-6 md:px-12 mt-16 text-xs text-muted-foreground">
    <div class="shell flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© {new Date().getFullYear()} RAÍCES · César López · Petrer (Alicante)</p>
      <div class="flex items-center gap-4">
        <a href="/aviso-legal" class="hover:text-primary transition-colors">Aviso Legal</a>
        <span>·</span>
        <a href="/privacidad" class="hover:text-primary transition-colors">Privacidad</a>
        <span>·</span>
        <a href="/cookies" class="hover:text-primary transition-colors">Cookies</a>
      </div>
    </div>
  </footer>
</Layout>
